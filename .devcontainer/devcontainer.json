{
  "name": "TP3 — YouTube Sentiment Analyzer",

  // Python 3.13, pour correspondre à l'environnement d'entraînement du modèle
  // (scikit-learn 1.9.1 exige Python >= 3.11).
  // Si le Codespace refuse de se construire sur ce tag, remplacer par
  // "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm".
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  // Docker dans le Codespace : permet de construire et lancer l'image de
  // production (Phase 6) sans installer Docker Desktop sur la machine locale.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // 8000 = API de développement (uvicorn)
  // 7860 = API de production (conteneur Docker)
  "forwardPorts": [8000, 7860],
  "portsAttributes": {
    "8000": {
      "label": "API FastAPI (dev)",
      "onAutoForward": "notify"
    },
    "7860": {
      "label": "API Docker (prod)",
      "onAutoForward": "notify"
    }
  },

  // Installe les dépendances dès la création du Codespace.
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  }
}
